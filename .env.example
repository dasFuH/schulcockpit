# ------------------------------------------------------------------
# Schul-Cockpit – Beispiel-Umgebungsvariablen
# Kopiere diese Datei zu ".env" und passe die Werte an.
# ------------------------------------------------------------------

# --- Datenbank (PostgreSQL) ---
# Bei lokaler Entwicklung ohne Docker: localhost:5432
# Im Docker-Compose-Netzwerk lautet der Host "db".
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=bitte_aendern_geheim
POSTGRES_DB=schulcockpit

# Verbindung der App zur DB. Innerhalb von Docker: host = "db".
# Lokal (App auf dem Host, DB in Docker): host = "localhost".
DATABASE_URL="postgresql://cockpit:bitte_aendern_geheim@localhost:5432/schulcockpit?schema=public"

# --- Auth / Session ---
# Geheimer Schlüssel zum Signieren der Session-Cookies (JWT).
# Erzeuge einen sicheren Wert, z. B.: openssl rand -base64 32
AUTH_SECRET=bitte_einen_langen_zufaelligen_wert_eintragen

# --- Datei-Uploads ---
# Verzeichnis für lokale Datei-/Foto-Uploads (im Container gemountet).
UPLOAD_DIR=./uploads

# --- App ---
# Öffentliche Basis-URL (für Reverse Proxy / HTTPS und Reset-Links relevant).
# Als vollständige http(s)-Origin ohne Pfad, Query oder Fragment setzen.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optionaler Host-Port für direkten Zugriff auf den Web-Container.
# Der Container selbst hört weiterhin intern auf Port 3000.
WEB_PORT=3000

# --- E-Mail / Passwort-Reset ---
# Generische SMTP-Verbindungs-URL, z. B.
# smtps://benutzer:passwort@smtp.example.com:465
SMTP_URL=
# Absenderadresse, optional mit Anzeigename, z. B.
# Schul-Cockpit <no-reply@example.com>
MAIL_FROM=

# --- Reverse Proxy (Caddy) ---
# Domain für automatisches HTTPS auf dem VPS.
APP_DOMAIN=cockpit.example.com
# E-Mail für Let's Encrypt (Caddy).
ACME_EMAIL=admin@example.com
# Externe Ports für Caddy. Für Let's Encrypt auf einem öffentlichen VPS sollten
# HTTP_PORT=80 und HTTPS_PORT=443 erreichbar sein.
HTTP_PORT=80
HTTPS_PORT=443

# Optionaler Host-Port für PostgreSQL-Debugging. Auf dem VPS besser nicht
# veröffentlichen oder per Firewall beschränken.
DB_PORT=5432
